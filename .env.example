FOUNDRY_PROJECT_ENDPOINT=https://ai-account-nlmcnaciofa6y.services.ai.azure.com/api/projects/ai-project-meetingtoaction
FOUNDRY_MODEL=gpt-5.4-mini
# Required for evaluation; must be a different deployed model than FOUNDRY_MODEL.
FOUNDRY_JUDGE_MODEL=
# AZURE_CONFIG_DIR=C:\Users\you\.azure-meetingtoactionagent

# Microsoft 365, Teams, and Outlook attachments (delegated desktop sign-in)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=organizations

# Existing Azure Blob container (authenticate with Azure CLI or managed identity)
# AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=meeting-transcripts
# AZURE_STORAGE_PREFIX=

# Google Drive and Gmail (OAuth desktop client)
# GOOGLE_OAUTH_CREDENTIALS=credentials.json
# GOOGLE_WORKSPACE_TOKEN=.google-workspace-token.json

# Zoom Server-to-Server OAuth and recording owner
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_USER_ID=user@example.com